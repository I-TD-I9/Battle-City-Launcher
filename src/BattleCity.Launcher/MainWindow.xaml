<Window x:Class="BattleCity.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BattleCity.Launcher"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Battle City Launcher"
        Width="600" Height="660" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The name, and how the server is. -->
    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="28,22,20,22">
      <DockPanel>
        <Image Source="Assets/BattleCity.png" Width="60" Height="60" Margin="0,0,16,0" DockPanel.Dock="Left"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ServerState}" Value="Online">
                      <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerState}" Value="Blocked">
                      <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServerState}" Value="Offline">
                      <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ServerText}" VerticalAlignment="Center" />
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0" Click="Refresh_Click"
                    IsEnabled="{Binding CanCheck}"
                    ToolTip="Check the server again" AutomationProperties.Name="Check the server again" />
          </StackPanel>
          <TextBlock Text="{Binding SignUpStateText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                     HorizontalAlignment="Right" Margin="0,0,30,0" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="BATTLE CITY" FontSize="30" FontWeight="Black" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- A newer launcher, when there is one. -->
    <Border Grid.Row="1" Background="#332B2350" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="28,10" Visibility="{Binding HasUpdate, Converter={StaticResource Shown}}">
      <TextBlock>
        <Run Text="{Binding UpdateText, Mode=OneWay}" />
        <Hyperlink Click="Update_Click">Download it</Hyperlink>
      </TextBlock>
    </Border>

    <TabControl Grid.Row="2" Margin="28,18,28,0">

      <TabItem Header="Play">
        <StackPanel Margin="0,24,0,0">
          <TextBlock Text="Game folder" Style="{StaticResource Label}" />
          <DockPanel>
            <Button Content="Change…" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Browse_Click" />
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Height="38" Padding="10,0">
              <TextBlock Text="{Binding GameFolderText}" ToolTip="{Binding GameFolderText}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </Border>
          </DockPanel>

          <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,2,8,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE7BA;" />
                  <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GameReady}" Value="True">
                      <Setter Property="Text" Value="&#xE73E;" />
                      <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding GameStatusText}" TextWrapping="Wrap" />
          </DockPanel>

          <Button Style="{StaticResource AccentButton}" Content="{Binding PlayText}" IsEnabled="{Binding CanPlay}"
                  Click="Play_Click" Height="58" Margin="0,30,0,0" FontSize="20" FontWeight="Bold" />

          <TextBlock Text="{Binding PlayError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PlayError}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Style="{StaticResource Note}" Margin="0,18,0,0">
            Log in with your Battle City account, exactly as you signed it up: your UserID is case-sensitive.
            No account yet? Make one under Create account.
          </TextBlock>
        </StackPanel>
      </TabItem>

      <TabItem Header="Create account">
        <StackPanel Margin="0,22,0,0">
          <!-- The last account made here, until the player asks for another. -->
          <StackPanel Visibility="{Binding ShowingLastAccount, Converter={StaticResource Shown}}">
            <TextBlock Text="Last account created" Style="{StaticResource Label}" />
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,7" HorizontalAlignment="Left" MinWidth="260">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="UserID" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,2,12,0" />
                <TextBlock Text="{Binding LastAccount}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource AccentButton}" Content="Create account" Click="NewAccount_Click"
                    Height="40" Padding="22,0" Margin="0,18,0,0" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- The form for a new account. -->
          <StackPanel Visibility="{Binding ShowingForm, Converter={StaticResource Shown}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="UserID" VerticalAlignment="Center" />
              <TextBox x:Name="UserIdBox" Grid.Row="0" Grid.Column="1"
                       Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                       MaxLength="16" AutomationProperties.Name="UserID" />
              <TextBlock Grid.Row="1" Text="Password" VerticalAlignment="Center" Margin="0,10,0,0" />
              <PasswordBox x:Name="Password" Grid.Row="1" Grid.Column="1" MaxLength="16" Margin="0,10,0,0"
                           AutomationProperties.Name="Password" />
              <TextBlock Grid.Row="2" Text="Confirm Password" VerticalAlignment="Center" Margin="0,10,0,0" />
              <PasswordBox x:Name="Confirm" Grid.Row="2" Grid.Column="1" MaxLength="16" Margin="0,10,0,0"
                           AutomationProperties.Name="Confirm Password" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="130,18,0,0">
              <Button Content="{Binding SignUpText}" IsEnabled="{Binding CanSignUp}" Click="SignUp_Click"
                      Height="40" Padding="22,0">
                <!-- Enter makes the account while the form is up on this page. -->
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                     Value="True" />
                          <Condition Binding="{Binding ShowingForm}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsDefault" Value="True" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Content="Cancel" Click="Cancel_Click" Height="40" Padding="18,0" Margin="10,0,0,0"
                      Visibility="{Binding HasLastAccount, Converter={StaticResource Shown}}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding SignUpMessage}" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SignUpSucceeded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding SignUpMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Style="{StaticResource Note}" Margin="0,18,0,0">
            The game can't make accounts, so make the one you'll log in with here. Use a password you
            don't use anywhere else: the way the game logs in means the server has to keep passwords in
            a form it can read back. There's no password reset yet.
          </TextBlock>
        </StackPanel>
      </TabItem>
    </TabControl>

    <!-- Which launcher this is, and where it comes from. -->
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}">
        <Run Text="{Binding VersionText, Mode=OneWay}" /> · <Hyperlink Click="Project_Click">Project page</Hyperlink>
      </TextBlock>
    </Border>
  </Grid>
</Window>
