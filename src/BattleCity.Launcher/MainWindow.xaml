<Window x:Class="BattleCity.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BattleCity.Launcher"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="Battle City Launcher"
        SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
    <!-- A page's main button: Enter presses it while its page is up. -->
    <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="22,0" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True" />
            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="IsDefault" Value="True" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A few words under a setting on what it does. -->
    <Style x:Key="SettingNote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <!-- The buttons beside it. -->
    <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid Width="900" Height="600">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="318" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The plaza, in an inked panel. -->
    <Grid Grid.Column="0" Margin="18,18,0,24">
      <Border Background="{StaticResource InkBrush}" CornerRadius="16" Margin="5,5,-5,-5" />
      <Border Background="{StaticResource InkBrush}" CornerRadius="16" Padding="3">
        <local:Plaza CornerRadius="13" />
      </Border>
    </Grid>

    <Grid Grid.Column="1" Margin="30,16,26,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The name, and how the server is. -->
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,4,0,0">
          <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                  CornerRadius="15" Padding="10,2,3,2">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="12" Height="12" Stroke="{StaticResource InkBrush}" StrokeThickness="1.5"
                       VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#FFB9BFC9" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ServerState}" Value="Online">
                        <Setter Property="Fill" Value="#FF34C76A" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Blocked">
                        <Setter Property="Fill" Value="#FFF2B227" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ServerState}" Value="Offline">
                        <Setter Property="Fill" Value="#FFE5483F" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ServerText}" Margin="7,0,0,1" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="3,0,0,0" Click="Refresh_Click"
                      IsEnabled="{Binding CanCheck}"
                      ToolTip="Check the server again" AutomationProperties.Name="Check the server again" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding SignUpStateText}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                     HorizontalAlignment="Right" Margin="0,5,12,0" />
        </StackPanel>
        <StackPanel>
          <local:OutlinedText Text="BATTLE CITY" FontSize="40" FontStyle="Italic" FontWeight="Black"
                              Fill="{StaticResource GoldBrush}" Stroke="{StaticResource InkBrush}" StrokeThickness="5"
                              Shadow="3.5" HorizontalAlignment="Left" AutomationProperties.Name="Battle City" />
          <StackPanel Orientation="Horizontal" Margin="1,9,0,0">
            <Rectangle Width="136" Height="16" VerticalAlignment="Center">
              <Rectangle.Fill>
                <ImageBrush ImageSource="{StaticResource LevelStar}" TileMode="Tile" Stretch="Uniform"
                            Viewport="0,0,17,16" ViewportUnits="Absolute" />
              </Rectangle.Fill>
            </Rectangle>
            <TextBlock Text="Yu-Gi-Oh! Online" Margin="10,0,0,1" VerticalAlignment="Center"
                       FontFamily="{StaticResource CardFont}" FontWeight="Bold" FontSize="15"
                       Typography.Capitals="SmallCaps" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,14,5,5" SelectionChanged="Tabs_SelectionChanged">

        <TabItem Header="Play">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,16,0,0">
              Log in with your Battle City account. Your UserID is case-sensitive, so type it exactly as
              you made it. No account yet, or forgot your password? Go to Account.
            </TextBlock>
            <StackPanel>
              <TextBlock Text="Game folder" Style="{StaticResource Heading}" />
              <DockPanel>
                <Button Content="Change…" DockPanel.Dock="Right" Margin="12,0,3,3" Click="Browse_Click" />
                <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                        CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,3">
                  <TextBlock Text="{Binding GameFolderText}" ToolTip="{Binding GameFolderText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </DockPanel>

              <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,2,8,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="&#xE7BA;" />
                      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding GameReady}" Value="True">
                          <Setter Property="Text" Value="&#xE73E;" />
                          <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding GameStatusText}" TextWrapping="Wrap" />
              </DockPanel>

              <Button Style="{StaticResource AccentButton}" Content="{Binding PlayText}" IsEnabled="{Binding CanPlay}"
                      Click="Play_Click" Height="62" Margin="0,20,4,4" FontSize="26" FontWeight="Black" FontStyle="Italic" />

              <!-- How the card pictures stand, nothing when the server hands out none. -->
              <TextBlock Text="{Binding PicturesText}" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                         TextWrapping="Wrap" Margin="2,10,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PicturesText}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <TextBlock Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                         Visibility="{Binding Outdated, Converter={StaticResource Shown}}">
                This launcher is out of date. <Hyperlink Click="Update_Click">Download the new one</Hyperlink>
                to keep playing.
              </TextBlock>

              <TextBlock Text="{Binding PlayError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,12,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PlayError}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </TabItem>

        <TabItem Header="Account">
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,14,0,0">
              Use a password you don't use anywhere else: the way the game logs in means the server has to
              keep it in a form it can read back.
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <!-- The account made or given a new password here last, until the player asks for another. -->
              <StackPanel Visibility="{Binding ShowingLastAccount, Converter={StaticResource Shown}}">
                <TextBlock Text="Your account" Style="{StaticResource Heading}" />
                <Grid HorizontalAlignment="Left" MinWidth="260" Margin="0,0,3,3">
                  <Border Background="{StaticResource InkBrush}" CornerRadius="8" Margin="3,3,-3,-3" />
                  <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                          CornerRadius="8" Padding="14,7,16,8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="UserID" Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                 VerticalAlignment="Center" Margin="0,2,12,0" />
                      <TextBlock Text="{Binding LastAccount}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource AccentButton}" Content="Create account" Click="NewAccount_Click"
                          Height="40" Padding="22,0" />
                  <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
                    <Hyperlink Click="Forgot_Click" IsEnabled="{Binding CanSubmit}">Forgot your password?</Hyperlink>
                  </TextBlock>
                </StackPanel>
              </StackPanel>

              <!-- A new account. -->
              <StackPanel Visibility="{Binding ShowingSignUp, Converter={StaticResource Shown}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="UserID" Style="{StaticResource FieldName}" />
                  <TextBox x:Name="UserIdBox" Grid.Row="0" Grid.Column="1"
                           Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="16" AutomationProperties.Name="UserID" />
                  <TextBlock Grid.Row="1" Text="Email" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                  <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                           Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="254" AutomationProperties.Name="Email" />
                  <TextBlock Grid.Row="2" Text="Password" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                  <PasswordBox x:Name="Password" Grid.Row="2" Grid.Column="1" MaxLength="16" Margin="0,8,0,0"
                               AutomationProperties.Name="Password" />
                  <TextBlock Grid.Row="3" Text="Confirm Password" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                  <PasswordBox x:Name="Confirm" Grid.Row="3" Grid.Column="1" MaxLength="16" Margin="0,8,0,0"
                               AutomationProperties.Name="Confirm Password" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="142,16,0,4">
                  <Button Style="{StaticResource PageButton}" Content="Create account" IsEnabled="{Binding CanSubmit}"
                          Click="SignUp_Click" />
                  <Button Style="{StaticResource SideButton}" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding CanSubmit}"
                          Visibility="{Binding HasLastAccount, Converter={StaticResource Shown}}" />
                  <!-- With an account made here, Cancel leads back to this link. -->
                  <TextBlock VerticalAlignment="Center" Margin="20,0,0,0"
                             Visibility="{Binding NoLastAccount, Converter={StaticResource Shown}}">
                    <Hyperlink Click="Forgot_Click" IsEnabled="{Binding CanSubmit}">Forgot your password?</Hyperlink>
                  </TextBlock>
                </StackPanel>
              </StackPanel>

              <!-- The code mailed for it. -->
              <StackPanel Visibility="{Binding ShowingSignUpCode, Converter={StaticResource Shown}}">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="A code is on its way to" /> <Run Text="{Binding CodeSentTo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Type it here to finish making your account," />
                  <Run Text="{Binding PendingName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                </TextBlock>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Code" Style="{StaticResource FieldName}" />
                  <TextBox x:Name="CodeBox" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                           Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="12" AutomationProperties.Name="Code" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="142,16,0,4">
                  <Button Style="{StaticResource PageButton}" Content="Confirm" IsEnabled="{Binding CanSubmit}"
                          Click="ConfirmSignUp_Click" />
                  <Button Style="{StaticResource SideButton}" Content="Back" Click="Back_Click" IsEnabled="{Binding CanSubmit}" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                  Nothing yet? Look in your spam folder, or
                  <Hyperlink Click="SignUpCodeAgain_Click" IsEnabled="{Binding CanSubmit}">send a new code</Hyperlink>.
                </TextBlock>
              </StackPanel>

              <!-- A forgotten password: the account's address first. -->
              <StackPanel Visibility="{Binding ShowingForgot, Converter={StaticResource Shown}}">
                <TextBlock Text="Forgot your password?" Style="{StaticResource Heading}" />
                <TextBlock TextWrapping="Wrap">
                  Type your account's email address. The server mails it a code to set a new password, and your
                  UserID with it.
                </TextBlock>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Email" Style="{StaticResource FieldName}" />
                  <TextBox x:Name="ForgotEmailBox" Grid.Column="1"
                           Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="254" AutomationProperties.Name="Email" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="142,16,0,4">
                  <Button Style="{StaticResource PageButton}" Content="Send code" IsEnabled="{Binding CanSubmit}"
                          Click="ForgotSend_Click" />
                  <Button Style="{StaticResource SideButton}" Content="Back" Click="Back_Click" IsEnabled="{Binding CanSubmit}" />
                </StackPanel>
              </StackPanel>

              <!-- Then the code, and the new password. -->
              <StackPanel Visibility="{Binding ShowingForgotCode, Converter={StaticResource Shown}}">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="If" /> <Run Text="{Binding CodeSentTo, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text="holds an account, a code is on its way to it." />
                </TextBlock>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Code" Style="{StaticResource FieldName}" />
                  <TextBox x:Name="ResetCodeBox" Grid.Row="0" Grid.Column="1" Width="160" HorizontalAlignment="Left"
                           Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="12" AutomationProperties.Name="Code" />
                  <TextBlock Grid.Row="1" Text="New Password" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                  <PasswordBox x:Name="NewPassword" Grid.Row="1" Grid.Column="1" MaxLength="16" Margin="0,8,0,0"
                               AutomationProperties.Name="New Password" />
                  <TextBlock Grid.Row="2" Text="Confirm Password" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                  <PasswordBox x:Name="NewConfirm" Grid.Row="2" Grid.Column="1" MaxLength="16" Margin="0,8,0,0"
                               AutomationProperties.Name="Confirm Password" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="142,16,0,4">
                  <Button Style="{StaticResource PageButton}" Content="Set password" IsEnabled="{Binding CanSubmit}"
                          Click="Reset_Click" />
                  <Button Style="{StaticResource SideButton}" Content="Back" Click="Back_Click" IsEnabled="{Binding CanSubmit}" />
                </StackPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                  Nothing yet? Look in your spam folder, or
                  <Hyperlink Click="ResetCodeAgain_Click" IsEnabled="{Binding CanSubmit}">send a new code</Hyperlink>.
                </TextBlock>
              </StackPanel>

              <TextBlock Text="Please wait…" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                         Visibility="{Binding Busy, Converter={StaticResource Shown}}" />

              <TextBlock Text="{Binding SignUpMessage}" TextWrapping="Wrap" Margin="0,10,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SignUpSucceeded}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding SignUpMessage}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- The launcher's settings, a row each under a heading for their group. The resolutions
             that fit are listed afresh each time the page comes up (Tabs_SelectionChanged). -->
        <TabItem x:Name="SettingsTab" Header="Settings">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <TextBlock Text="Display" Style="{StaticResource Heading}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="142" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Resolution" Style="{StaticResource FieldName}" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,3"
                          ItemsSource="{Binding Resolutions}" SelectedItem="{Binding ChosenResolution}"
                          IsEnabled="{Binding ResolutionChangeable}" TextSearch.TextPath="Label"
                          AutomationProperties.Name="Resolution">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                  </ComboBox.ItemContainerStyle>
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <Image Source="{StaticResource LevelStar}" Width="14" Height="14" Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Sharp, Converter={StaticResource Shown}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                  <TextBlock Style="{StaticResource SettingNote}" Foreground="{StaticResource TextBrush}"
                             Visibility="{Binding ResolutionFixed, Converter={StaticResource Shown}}">
                    Only Default can be used: the launcher's folder, under your Windows user name, has letters
                    the game can't read.
                  </TextBlock>
                  <TextBlock Style="{StaticResource SettingNote}">
                    Default is the game's own window, 800&#160;x&#160;600.
                  </TextBlock>
                  <TextBlock Style="{StaticResource SettingNote}"
                             Visibility="{Binding SharpOffered, Converter={StaticResource Shown}}">
                    The sizes with a <InlineUIContainer BaselineAlignment="Center"><Image Source="{StaticResource LevelStar}"
                    Width="12" Height="12" /></InlineUIContainer> are the sharpest: whole multiples of
                    800&#160;x&#160;600.
                  </TextBlock>
                  <TextBlock Style="{StaticResource SettingNote}">
                    Only the sizes that fit this screen are listed, and full screen uses the main monitor.
                  </TextBlock>
                  <TextBlock Style="{StaticResource SettingNote}">
                    A change takes effect the next time you press Play.
                  </TextBlock>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <!-- Which launcher this is and where it comes from, and a newer one when there is one. -->
      <DockPanel Grid.Row="2" Margin="0,12,5,0">
        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
          <Run Text="{Binding VersionText, Mode=OneWay}" /> · <Hyperlink Click="Project_Click">Project page</Hyperlink>
        </TextBlock>
        <Border Background="{StaticResource GoldBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2"
                CornerRadius="12" Padding="10,2,12,3" HorizontalAlignment="Left"
                Visibility="{Binding ShowUpdate, Converter={StaticResource Shown}}">
          <TextBlock FontSize="12.5" FontWeight="SemiBold">
            <Run Text="{Binding UpdateText, Mode=OneWay}" />
            <Hyperlink Click="Update_Click" Foreground="{StaticResource InkBrush}" TextDecorations="Underline">Download it</Hyperlink>
          </TextBlock>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
