<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The launcher's colours come from the plaza on a summer day: the sky, the clock's gold and
       the ink of a manga page, on paper. Its pages sit in a frame like a card's, with the
       text on parchment. -->
  <Color x:Key="PaperColor">#FFFBF8F1</Color>
  <Color x:Key="InkColor">#FF1C2230</Color>
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="#FF5C6576" />
  <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FFE6F2FC" />
  <SolidColorBrush x:Key="SkyBrush" Color="#FF2470C8" />
  <SolidColorBrush x:Key="ParchmentBrush" Color="#FFF8F0DC" />
  <SolidColorBrush x:Key="ParchmentLineBrush" Color="#FFB89B5E" />
  <SolidColorBrush x:Key="BronzeBrush" Color="#FF7A5716" />
  <SolidColorBrush x:Key="FlavourBrush" Color="#FF4D4333" />
  <SolidColorBrush x:Key="GoodBrush" Color="#FF1E8A4C" />
  <SolidColorBrush x:Key="BadBrush" Color="#FFC33636" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFC17F06" />
  <SolidColorBrush x:Key="DisabledBrush" Color="#FFE3DFD6" />

  <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFE58C" />
    <GradientStop Offset="0.55" Color="#FFF2C445" />
    <GradientStop Offset="1" Color="#FFD49A22" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldHoverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFEDAA" />
    <GradientStop Offset="0.55" Color="#FFF7D060" />
    <GradientStop Offset="1" Color="#FFDDA733" />
  </LinearGradientBrush>

  <!-- The card's frame, and the tab of the page on show, which runs into it. -->
  <SolidColorBrush x:Key="FrameTopBrush" Color="#FFF0C653" />
  <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFF0C653" />
    <GradientStop Offset="1" Color="#FFDDA535" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TabBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFFE38A" />
    <GradientStop Offset="1" Color="#FFF0C653" />
  </LinearGradientBrush>

  <!-- Headings in a card name's serif, notes in its flavour text's italic. -->
  <FontFamily x:Key="CardFont">Palatino Linotype, Georgia</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- A level star, as on a monster card. -->
  <DrawingImage x:Key="LevelStar">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="8,8" RadiusX="7.2" RadiusY="7.2" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3">
              <GradientStop Offset="0" Color="#FFFF8A4C" />
              <GradientStop Offset="1" Color="#FFC2300F" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="{StaticResource InkBrush}" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFFE14D"
                         Geometry="M8,2.7 L9.32,6.28 13.14,6.43 10.14,8.8 11.17,12.47 8,10.35 4.83,12.47 5.86,8.8 2.86,6.43 6.68,6.28 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF7A2A0A" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-4" BorderBrush="{StaticResource SkyBrush}" BorderThickness="2" CornerRadius="11" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A plain button: white, inked round, with a hard shadow it presses down into. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Shadow" Background="{StaticResource InkBrush}" CornerRadius="8" Margin="3,3,-3,-3" />
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="2" Y="2" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBrush}" />
              <Setter TargetName="Shadow" Property="Opacity" Value="0.35" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The one thing to press on each page, in the clock's gold. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource GoldBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Shadow" Background="{StaticResource InkBrush}" CornerRadius="10" Margin="4,4,-4,-4" />
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <!-- A shine along the top edge. -->
                <Border Height="2" VerticalAlignment="Top" Margin="6,1,6,0" CornerRadius="1" Background="#B3FFFFFF" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource GoldHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="3" Y="3" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBrush}" />
              <Setter TargetName="Shadow" Property="Opacity" Value="0.35" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A small button holding one icon. -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="Transparent" CornerRadius="12" Padding="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SkyBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Box" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Field" TargetType="Control">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SkyBrush}" />
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SkyBrush}" />
  </Style>

  <!-- The two pages, Play and Account, as a card: an inked gold frame with the page on
       parchment inside, and the tab of the page on show running into the frame. -->
  <Style TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1" Margin="16,0,0,-2.5" />
            <Border Grid.Row="1" Background="{StaticResource InkBrush}" CornerRadius="14" Margin="5,5,-5,-5" />
            <Border Grid.Row="1" Background="{StaticResource FrameBrush}" BorderBrush="{StaticResource InkBrush}"
                    BorderThickness="2.5" CornerRadius="14" Padding="9">
              <Border Background="{StaticResource ParchmentBrush}" BorderBrush="{StaticResource ParchmentLineBrush}"
                      BorderThickness="1.5" CornerRadius="7" Padding="22,18,22,16">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </Border>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The header's lettering is set on the header alone: a page's content inherits from its tab,
       and it keeps the window's own. -->
  <Style TargetType="TabItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource InkBrush}"
                  BorderThickness="2.5" CornerRadius="10,10,0,0" Padding="18,6,18,6" Margin="0,4,8,0">
            <ContentPresenter x:Name="Header" ContentSource="Header" TextElement.FontFamily="{StaticResource CardFont}"
                              TextElement.FontSize="16.5" TextElement.FontWeight="Bold"
                              TextElement.Foreground="{StaticResource MutedBrush}" Typography.Capitals="SmallCaps" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="{StaticResource TabBrush}" />
              <Setter TargetName="Tab" Property="BorderThickness" Value="2.5,2.5,2.5,0" />
              <Setter TargetName="Tab" Property="Padding" Value="18,9,18,8.5" />
              <Setter TargetName="Tab" Property="Margin" Value="0,0,8,0" />
              <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource SkyBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource SkyBrush}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A heading on a page, set like a card's name. -->
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CardFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Typography.Capitals" Value="SmallCaps" />
    <Setter Property="Foreground" Value="{StaticResource BronzeBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- The name of a box on a form. -->
  <Style x:Key="FieldName" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A few lines of advice at the foot of a page, in a card's flavour-text italic. -->
  <Style x:Key="Note" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CardFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource FlavourBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
</ResourceDictionary>
