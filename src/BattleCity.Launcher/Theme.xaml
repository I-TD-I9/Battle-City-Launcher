<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The launcher's colours: the night sky and gold of its icon. -->
  <Color x:Key="NightColor">#FF12121C</Color>
  <Color x:Key="DuskColor">#FF2B2350</Color>
  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource NightColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1C1C2B" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF26263B" />
  <SolidColorBrush x:Key="LineBrush" Color="#FF34344F" />
  <SolidColorBrush x:Key="TextBrush" Color="#FFECECF4" />
  <SolidColorBrush x:Key="MutedBrush" Color="#FFA3A3BC" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFE8B64C" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFF2C766" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFD19F37" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FF1A1408" />
  <SolidColorBrush x:Key="GoodBrush" Color="#FF5BD08A" />
  <SolidColorBrush x:Key="BadBrush" Color="#FFFF7A7A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFF2C14E" />
  <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="{StaticResource DuskColor}" />
    <GradientStop Offset="1" Color="{StaticResource NightColor}" />
  </LinearGradientBrush>

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A plain button: a dark surface with a thin line round it. -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The one thing to press on each page. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource LineBrush}" />
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A small round button holding one icon. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
    <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Box" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Field" TargetType="Control">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="38" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- The two pages, Play and Create account, as tabs underlined in gold. -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" />
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                  Padding="2,10" Margin="0,0,24,-1">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="Note" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
</ResourceDictionary>
